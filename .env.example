# Copy to .env.local (ignored by git) and restart `npx expo start` after changes.

# FastAPI backend (barterdito-backend). Leave empty in development to use the computer
# that runs `npx expo start`, port 5000; start uvicorn with --host 0.0.0.0 so phones can reach it.
# Set it when the backend uses another port or host, and always for production builds (HTTPS).
EXPO_PUBLIC_API_URL=

# Public website (barterdito-web). Used for share, QR, and invite links, and sent as the
# trusted Origin on account writes, so it must be one of the backend's CORS_ORIGINS.
EXPO_PUBLIC_SITE_URL=http://localhost:3000

# Same UI preview switch as the website's NEXT_PUBLIC_SENTINEL_PREVIEW. Not authorization.
EXPO_PUBLIC_SENTINEL_PREVIEW=false
